# Desarrollo local (backend en localhost)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Producción (Vercel + backend en Render): usar URL relativa para que el API
# pase por el proxy del frontend y la cookie de sesión quede en el mismo dominio.
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_ORIGIN=https://<tu-backend>.onrender.com
# JWT_SECRET=<misma clave que SECRET_KEY del backend>
